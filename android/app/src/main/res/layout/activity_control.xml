<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f19">

    <!-- ═══ APP BAR ═══ -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#121826"
        app:elevation="0dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="Webcam Remote Control"
            app:titleTextColor="#ffffff" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- ═══ CONTENT SCROLLVIEW ═══ -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="16dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 1. Connection Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CC121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="WINDOWS BRIDGE PC CONNECTION"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#06b6d4"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="12dp"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            app:boxStrokeColor="#06b6d4"
                            app:hintTextColor="#6b7280"
                            android:textColorHint="#6b7280"
                            app:boxCornerRadiusTopStart="10dp"
                            app:boxCornerRadiusTopEnd="10dp"
                            app:boxCornerRadiusBottomStart="10dp"
                            app:boxCornerRadiusBottomEnd="10dp">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etBridgeIp"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Bridge address (USB: 127.0.0.1:5134)"
                                android:inputType="textUri"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnConnect"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="Sync"
                            app:cornerRadius="10dp"
                            android:textColor="#0b0f19"
                            app:backgroundTint="#06b6d4" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvConnectionStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Status: Not connected"
                        android:textColor="#9ca3af"
                        android:textSize="13sp"
                        android:layout_marginTop="10dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- 2. System Actions Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRecord"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:layout_marginEnd="4dp"
                    android:text="Record"
                    android:textColor="#ffffff"
                    app:backgroundTint="#ef4444"
                    app:cornerRadius="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCapture"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:text="Capture"
                    android:textColor="#ffffff"
                    app:backgroundTint="#10b981"
                    app:cornerRadius="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnResetPipeline"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.0"
                    android:layout_marginStart="4dp"
                    android:text="Reset"
                    android:textColor="#ffffff"
                    app:backgroundTint="#3b82f6"
                    app:cornerRadius="12dp"
                    android:textSize="12sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 3. Sliders / Faders Panel -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CC121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIDEO PROCESSING FILTERS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#06b6d4"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp"/>

                    <!-- Brightness -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Brightness"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvBrightnessValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.00"
                                android:textColor="#f59e0b"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbBrightness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="200"
                            android:progress="100"/>
                    </LinearLayout>

                    <!-- Contrast -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Contrast"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvContrastValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textColor="#06b6d4"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbContrast"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="150"
                            android:progress="50"/>
                    </LinearLayout>

                    <!-- Saturation -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Saturation"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvSaturationValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.00"
                                android:textColor="#a855f7"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbSaturation"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="200"
                            android:progress="100"/>
                    </LinearLayout>

                    <!-- Sharpness -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Sharpness"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvSharpnessValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0.0"
                                android:textColor="#10b981"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbSharpness"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="20"
                            android:progress="0"/>
                    </LinearLayout>

                    <!-- Background Blur -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="14dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Blur"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvBlurValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Off"
                                android:textColor="#f43f5e"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbBlur"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="25"
                            android:progress="0"/>
                    </LinearLayout>

                    <!-- Zoom -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Hardware Zoom"
                                android:textColor="#ffffff"
                                android:textSize="14sp" />
                            <TextView
                                android:id="@+id/tvZoomValue"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1.0x"
                                android:textColor="#06b6d4"
                                android:textSize="14sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                        <SeekBar
                            android:id="@+id/sbZoom"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:max="20"
                            android:progress="0"/>
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Reset Filters Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnResetFilters"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Reset Filters to Default"
                android:textColor="#f59e0b"
                app:strokeColor="#f59e0b"
                app:cornerRadius="12dp"
                android:layout_marginBottom="16dp"
                android:textStyle="bold" />

            <!-- 4. Switches & Dropdowns -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#CC121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp"
                android:layout_marginBottom="24dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="SYSTEM CONFIGURATION"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#06b6d4"
                        android:letterSpacing="0.1"
                        android:layout_marginBottom="16dp"/>

                    <!-- Mirror Feed Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Mirror Feed"
                            android:textColor="#ffffff"
                            android:textSize="14sp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swMirror"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- OBS VCam Switch -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="20dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="OBS Virtual Camera"
                            android:textColor="#ffffff"
                            android:textSize="14sp" />
                        <com.google.android.material.switchmaterial.SwitchMaterial
                            android:id="@+id/swVcam"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />
                    </LinearLayout>

                    <!-- Camera Source Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Streamer Camera"
                            android:textColor="#9ca3af"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spCameraFacing"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:textColor="#ffffff" />
                    </LinearLayout>

                    <!-- Resolution Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Resolution"
                            android:textColor="#9ca3af"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spResolution"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:textColor="#ffffff" />
                    </LinearLayout>

                    <!-- FPS Limit Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="FPS Limit"
                            android:textColor="#9ca3af"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spFps"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:textColor="#ffffff" />
                    </LinearLayout>

                    <!-- Orientation Spinner -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Orientation Rotation"
                            android:textColor="#9ca3af"
                            android:textSize="12sp"
                            android:layout_marginBottom="4dp"/>
                        <Spinner
                            android:id="@+id/spOrientation"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:background="@drawable/spinner_background"
                            android:textColor="#ffffff" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
