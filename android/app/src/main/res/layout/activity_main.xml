<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0b0f19">

    <!-- ═══ FULL-SCREEN CAMERA PREVIEW ═══ -->
    <TextureView
        android:id="@+id/cameraPreview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"/>

    <!-- ═══ TOP GRADIENT OVERLAY ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:background="@drawable/gradient_top_overlay"
        android:layout_gravity="top"/>

    <!-- ═══ BOTTOM GRADIENT OVERLAY ═══ -->
    <View
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:background="@drawable/gradient_bottom_overlay"
        android:layout_gravity="bottom"/>

    <!-- ═══ TOP BAR — App name + recording indicator ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_gravity="top"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="48dp"
        android:paddingBottom="16dp">

        <!-- Pulsing dot -->
        <View
            android:id="@+id/statusPulse"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/circle_core"
            android:layout_marginEnd="10dp"/>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Webcam Bridge"
                android:textSize="18sp"
                android:textColor="#ffffff"
                android:textStyle="bold"
                android:letterSpacing="-0.02"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Live Camera Stream"
                android:textSize="12sp"
                android:textColor="#9ca3af"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- REC badge -->
        <TextView
            android:id="@+id/tvRecBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● LIVE"
            android:textSize="11sp"
            android:textColor="#10b981"
            android:textStyle="bold"
            android:letterSpacing="0.05"
            android:visibility="gone"/>
    </LinearLayout>

    <!-- ═══ BOTTOM INFO PANEL ═══ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="32dp"
        android:paddingTop="16dp">

        <!-- Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#CC121826"
            app:strokeColor="#1f2937"
            app:strokeWidth="1dp"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="CONNECTION STATUS"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        android:textColor="#06b6d4"
                        android:letterSpacing="0.12"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchCamera"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CAM ▾"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#06b6d4"
                        android:padding="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnSwitchMode"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ROLE"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="#f59e0b"
                        android:padding="0dp"
                        android:layout_marginStart="12dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Starting…"
                    android:textSize="15sp"
                    android:textColor="#f3f4f6"
                    android:gravity="start"
                    android:lineSpacingMultiplier="1.3"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Stats Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:weightSum="3">

            <!-- Port -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#99121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PORT"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#6b7280"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8080"
                        android:textSize="16sp"
                        android:textColor="#06b6d4"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- FPS -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#99121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FPS"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#6b7280"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="30"
                        android:textSize="16sp"
                        android:textColor="#f59e0b"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Resolution -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#99121826"
                app:strokeColor="#1f2937"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:gravity="center">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RES"
                        android:textSize="9sp"
                        android:textStyle="bold"
                        android:textColor="#6b7280"
                        android:letterSpacing="0.1"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="720p"
                        android:textSize="16sp"
                        android:textColor="#10b981"
                        android:textStyle="bold"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>

    <!-- Hidden Button for backward-compat with Kotlin code -->
    <Button
        android:id="@+id/btnToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"/>

    <!-- ═══ MODE SELECTION OVERLAY ═══ -->
    <LinearLayout
        android:id="@+id/modeSelectionOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#0b0f19"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp"
        android:clickable="true"
        android:focusable="true">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WebCam Bridge"
            android:textColor="#ffffff"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select this device's role"
            android:textColor="#9ca3af"
            android:textSize="14sp"
            android:layout_marginBottom="32dp" />

        <!-- Streamer Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardStreamerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#CC121826"
            app:strokeColor="#1f2937"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📹 Camera Streamer"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#06b6d4"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Stream this phone's camera to your PC over USB."
                    android:textColor="#9ca3af"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Controller Mode Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardControllerMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#CC121826"
            app:strokeColor="#1f2937"
            app:strokeWidth="1dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🎛️ Remote Controller"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#10b981"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Control camera filters, zoom, focus, and recording from this phone."
                    android:textColor="#9ca3af"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Remember Choice Checkbox -->
        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/cbRememberChoice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Remember my choice"
            android:textColor="#9ca3af"
            android:textSize="14sp"
            android:layout_marginTop="20dp"
            app:buttonTint="#06b6d4" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
