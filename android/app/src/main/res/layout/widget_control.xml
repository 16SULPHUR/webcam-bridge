<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Top Row: Title + Status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="WebCam Remote"
            android:textColor="#ffffff"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Status Light Dot -->
        <ImageView
            android:id="@+id/widget_status_dot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/widget_dot_inactive"
            android:layout_marginEnd="6dp" />

        <TextView
            android:id="@+id/widget_tv_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Offline"
            android:textColor="#9ca3af"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/widget_btn_sync"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" ↻ "
            android:textColor="#06b6d4"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#1f2937"
        android:layout_marginBottom="8dp" />

    <!-- Middle Row: Zoom / Brightness Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <!-- Zoom Control Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginEnd="4dp"
            android:background="@drawable/widget_control_block_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/widget_btn_zoom_down"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="Z-"
                android:textSize="10sp"
                android:textColor="#06b6d4"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/widget_tv_zoom_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zoom"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_btn_zoom_up"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="Z+"
                android:textSize="10sp"
                android:textColor="#06b6d4"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

        <!-- Brightness Control Block -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_control_block_bg"
            android:padding="4dp">

            <TextView
                android:id="@+id/widget_btn_brightness_down"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="B-"
                android:textSize="10sp"
                android:textColor="#f59e0b"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/widget_tv_brightness_val"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Bright"
                android:textColor="#ffffff"
                android:textSize="10sp"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp" />

            <TextView
                android:id="@+id/widget_btn_brightness_up"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="B+"
                android:textSize="10sp"
                android:textColor="#f59e0b"
                android:background="@drawable/widget_btn_bg"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bottom Row: REC / RST Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_btn_record"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="REC"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/widget_btn_rec_bg"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/widget_btn_reset"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="RESET"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="#ffffff"
            android:background="@drawable/widget_btn_reset_bg"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

</LinearLayout>
